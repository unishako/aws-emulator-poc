# docker compose が使う環境変数の一覧。
# 変更したい場合は、このファイルを .env にコピーして値を書き換える (.env は Git の管理対象外)。
# 未設定の場合は、ここに書かれた既定値が使われる。

# AWS Emulator の RPM のアーキテクチャ。
#   Apple silicon / Arm: aarch64 (既定)
#   Intel / AMD:         x86_64
RPM_ARCH=aarch64

# コンテナを実行するユーザー。.emulator/ に生成されるファイルの所有者になる。
# Linux では自分のユーザーに合わせる (id -u / id -g の値)。
LOCAL_UID=1000
LOCAL_GID=1000

# ホスト側のポート (127.0.0.1 のみで待ち受ける)
APP_PORT=8080
